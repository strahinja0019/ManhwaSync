<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.ManhwaSync.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.ManhwaSync.AppWidgetContainer">

    <ImageView
        android:id="@+id/imgManhwaLogo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="false"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:id="@+id/txtvManhwaTitle"
        android:layout_width="wrap_content"
        android:layout_height="59dp"
        android:layout_below="@id/imgManhwaLogo"
        android:layout_marginStart="36dp"
        android:layout_marginTop="-66dp"
        android:layout_toEndOf="@+id/imgManhwaLogo"
        android:text="Manhwa Title" />

    <Button
        android:id="@+id/btnOpenMihon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtvManhwaTitle"
        android:layout_marginStart="36dp"
        android:layout_marginTop="17dp"
        android:layout_toEndOf="@+id/h"
        android:text="OPEN IN MIHON" />

    <TextView
        android:id="@+id/hourNeeded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/txtvManhwaTitle"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="-50dp"
        android:layout_toEndOf="@+id/textView"
        android:text="100" />

    <TextView
        android:id="@+id/h"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtvManhwaTitle"
        android:layout_marginStart="0dp"
        android:layout_marginTop="31dp"
        android:layout_toEndOf="@+id/hourNeeded"
        android:text="h" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtvManhwaTitle"
        android:layout_marginTop="31dp"
        android:text="Average Readtime:" />

</RelativeLayout>